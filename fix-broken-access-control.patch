-  async getBoletim(@Param('id') id: string) {
+  async getBoletim(@Param('id') id: string, @Req() req: Request) {
+    const user = (req as any).user;
+
+    // Checagem de propriedade (BAC-02 / IDOR): um aluno só pode ver o
